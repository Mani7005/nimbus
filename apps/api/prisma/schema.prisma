generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String      @id @default(cuid())
  email      String      @unique
  password   String
  createdAt  DateTime    @default(now())

  executions Execution[]
}

model Execution {

  id          String   @id @default(cuid())

  language    String

  code        String

  output      String?

  status      String   @default("PENDING")

  createdAt   DateTime @default(now())

  userId      String

  user        User @relation(fields: [userId], references: [id])
}