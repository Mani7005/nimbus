# Loaded by `pnpm test` (node --env-file) so unit tests pass env validation without apps/api/.env.
# Fake values only: unit tests mock Prisma and BullMQ and never connect. Real environment variables take precedence.
DATABASE_URL=postgresql://nimbus:nimbus@localhost:5432/nimbus_unit_test
REDIS_URL=redis://localhost:6379
JWT_SECRET=unit-test-secret-not-for-any-real-environment
NODE_ENV=test
# Each test file runs in its own process with a single in-process app, so the in-memory store is correct here.
RATE_LIMIT_STORE=memory
